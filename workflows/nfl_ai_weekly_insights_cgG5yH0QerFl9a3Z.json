        "jsCode": "// Function to calculate the estimated duration based on file size and bitrate\nfunction calculateDuration(fileSizeBytes) {\n    // Define the bitrate (in bits per second).\n    // IMPORTANT:\n    // Use 128000 for 128 kbps (ElevenLabs standard output).\n    // Use 192000 for 192 kbps (Creator/Pro tier output - more accurate if applicable).\n    const bitrateBps = 128000; \n    \n    // Check for valid input\n    if (fileSizeBytes > 0 && bitrateBps > 0) {\n        // Formula: (Bytes * 8) / Bits per second = Duration in Seconds\n        return (fileSizeBytes * 8) / bitrateBps;\n    }\n    \n    return 0; \n}\n\n// Get the first item's JSON data (assuming single file upload)\nconst item = $input.first().json;\n\n// 1. URL Generation\nconst fileId = item.id; // Assuming 'id' is available from the Google Drive output\nconst audioUrl = `https://drive.google.com/uc?export=download&id=${fileId}`;\n\n// 2. Duration Calculation\n// The 'size' property from your Google Drive output is a string, so we convert it.\nconst fileSizeString = item.size;\nconst fileSizeBytes = Number(fileSizeString);\nconst durationSeconds = calculateDuration(fileSizeBytes);\n\n// Optional: Format the time for better readability\nconst minutes = Math.floor(durationSeconds / 60);\nconst seconds = Math.round(durationSeconds % 60);\nconst formattedTime = `${minutes}:${seconds.toString().padStart(2, '0')}`;\n\n// 3. Return the new item with added properties\nreturn [{\n    json: {\n        ...item, // Keep all existing Google Drive properties\n        audio_url: audioUrl, // The new public audio URL\n        audioDurationSeconds: durationSeconds, // The duration in seconds (float)\n        audioDurationFormatted: formattedTime // The duration in M:SS format\n    }\n}];"
      },
