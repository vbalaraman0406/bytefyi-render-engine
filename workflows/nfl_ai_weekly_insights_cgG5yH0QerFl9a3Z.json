    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst allGames = data.game_predictions || [];\n\nfunction getConfidenceClass(c) {\n  const n = parseInt(c);\n  return n >= 80 ? 'confidence-high' : n >= 50 ? 'confidence-medium' : 'confidence-low';\n}\n\nconst games = allGames.map((g, i) => `<div class=\"item\"><span class=\"rank\">${i + 1}.</span><div class=\"info\"><div class=\"team\">${g.pick || ''}</div><div class=\"match\">${g.matchup || ''}</div></div><div class=\"badge ${getConfidenceClass(g.confidence)}\">${g.confidence}%</div></div>`).join('');\n\nconst tConf = parseInt(data.top_pick_of_week?.confidence || 0);\nconst tBg = tConf >= 80 ? '#2e7d32' : tConf >= 50 ? '#ffd700' : '#d32f2f';\nconst tCol = tConf >= 50 && tConf < 80 ? '#1a237e' : 'white';\n\nreturn [{json:{...data,html_infographic:`<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=1080,height=1920\"><style>*{margin:0;padding:0;box-sizing:border-box}html,body{width:1080px;height:1920px;margin:0;padding:0;overflow:hidden}body{font-family:'Arial Black',Arial,sans-serif;background:linear-gradient(135deg,#0d47a1 0%,#1565c0 30%,#6a1b9a 70%,#c62828 100%)}.container{width:1080px;height:1920px;padding:40px 40px;display:flex;flex-direction:column;box-sizing:border-box}.header{text-align:center;margin-bottom:25px}.header h1{color:#fff;font-size:64px;letter-spacing:5px;text-shadow:4px 4px 8px rgba(0,0,0,.5)}.header h2{color:#ffd700;font-size:38px;letter-spacing:2px;text-shadow:3px 3px 6px rgba(0,0,0,.5)}.top{background:linear-gradient(135deg,#c62828 0%,#d32f2f 100%);border:4px solid #ffd700;border-radius:20px;padding:25px;margin-bottom:25px;text-align:center;box-shadow:0 8px 25px rgba(0,0,0,.5)}.top h3{color:#ffd700;font-size:22px;margin-bottom:15px;text-shadow:2px 2px 4px rgba(0,0,0,.5)}.top .team{color:#fff;font-size:48px;margin-bottom:10px;text-shadow:3px 3px 6px rgba(0,0,0,.5)}.top .match{color:rgba(255,255,255,.9);font-size:20px;margin-bottom:12px}.top .conf{background:${tBg};color:${tCol};font-size:42px;padding:10px 35px;border-radius:35px;display:inline-block;font-weight:bold}.pred-head{background:rgba(0,0,0,.4);padding:12px;border-radius:10px;margin-bottom:12px}.pred-head h3{color:#fff;font-size:24px;text-align:center}.preds{flex:1;display:flex;flex-direction:column;gap:8px;overflow:hidden}.item{background:rgba(255,255,255,.1);border-left:4px solid #ffd700;padding:12px 15px;border-radius:8px;display:flex;align-items:center;backdrop-filter:blur(10px);height:80px}.info{flex:1;display:flex;flex-direction:column;justify-content:center;min-width:0}.rank{color:#ffd700;font-size:20px;margin-right:10px;min-width:35px;flex-shrink:0}.team{color:#fff;font-size:24px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.match{color:rgba(255,255,255,.7);font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.badge{font-size:28px;padding:8px 20px;border-radius:20px;font-weight:bold;min-width:90px;text-align:center;color:#fff;flex-shrink:0}.confidence-low{background:#d32f2f}.confidence-medium{background:#ffd700;color:#1a237e}.confidence-high{background:#2e7d32}.footer{text-align:center;margin-top:15px;padding-top:12px;border-top:3px solid rgba(255,255,255,.3)}.footer p{color:rgba(255,255,255,.8);font-size:18px}</style></head><body><div class=\"container\"><div class=\"header\"><h1>\ud83c\udfc8 NFL WEEK ${data.week}</h1><h2>AI PREDICTIONS</h2></div><div class=\"top\"><h3>\ud83c\udfc6 TOP PICK OF THE WEEK \ud83c\udfc6</h3><div class=\"team\">${data.top_pick_of_week?.team || ''}</div><div class=\"match\">${data.top_pick_of_week?.matchup || ''}</div><div class=\"conf\">${data.top_pick_of_week?.confidence || 0}%</div></div><div class=\"pred-head\"><h3>\ud83d\udcca ALL GAME PREDICTIONS</h3></div><div class=\"preds\">${games}</div><div class=\"footer\"><p>\u26a1 ${data.total_games} GAMES | \ud83e\udd16 AI POWERED</p></div></div></body></html>`}}];"
