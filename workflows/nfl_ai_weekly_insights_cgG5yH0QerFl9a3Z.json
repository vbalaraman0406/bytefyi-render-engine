    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// Get all games\nconst allGames = data.game_predictions || [];\nconst totalGames = data.total_games || allGames.length || 0;\n\n// --- Build the video script ---\nconst script = `[HOOK]\n\ud83c\udfc8 NFL Week ${data.week} AI Predictions - ${totalGames} Games Analyzed!\n\n[TOP PICK]\n\ud83c\udfc6 ${data.top_pick_of_week?.team || ''}\n${data.top_pick_of_week?.matchup || ''}\n\n[OTHER PICKS]\n${allGames.map((g, i) => `${i + 1}. ${g.pick} (${g.confidence}%)`).join('\\n')}\n\n[CTA]\nFull predictions in newsletter \u2192 Link in bio!`;\n\n// --- Build the narration text for TTS ---\nlet narrationParts = [];\nnarrationParts.push(`NFL Week ${data.week}. We analyzed all ${totalGames} games.`);\n\nif (data.top_pick_of_week?.team) {\n  narrationParts.push(`Our top pick of the week is ${data.top_pick_of_week.team}. ${data.top_pick_of_week.reason || ''}`);\n}\n\n// Add narration for every game\nallGames.forEach((g, i) => {\n  const matchup = g.matchup ? `In the game between ${g.matchup},` : `Game ${i + 1},`;\n  narrationParts.push(`${matchup} our AI predicts ${g.pick} with ${g.confidence} percent confidence.`);\n});\n\n// Add closing CTA\nnarrationParts.push(`Subscribe to our newsletter for the full breakdown and weekly updates.`);\n\n// Join all narration parts into a single smooth paragraph\nconst narrationText = narrationParts.join(' ');\n\nreturn [{\n  json: {\n    ...data,\n    video_script: script,\n    narration_text: narrationText,\n    video_title: `NFL Week ${data.week} - AI Predictions for ALL ${totalGames} Games`,\n    video_description: `AI predictions for every NFL game this week. Top pick: ${data.top_pick_of_week?.team || ''}. Full analysis in newsletter!`,\n    video_tags: ['NFL', 'AI Picks', 'Week ' + data.week, 'All Games', 'Predictions']\n  }\n}];\n"
      },
