    {
      "parameters": {
        "jsCode": "// Extract only essential data from ESPN response\nconst espnData = $input.first().json;\n\n// Get week number\nconst week = espnData.week?.number || espnData.leagues?.[0]?.season?.week || 1;\n\n// Extract ALL games (removed slice limit)\nconst games = espnData.events?.map(event => {\n  const comp = event.competitions?.[0];\n  const homeTeam = comp?.competitors?.find(c => c.homeAway === 'home');\n  const awayTeam = comp?.competitors?.find(c => c.homeAway === 'away');\n  \n  return {\n    matchup: `${awayTeam?.team?.displayName} @ ${homeTeam?.team?.displayName}`,\n    awayTeam: awayTeam?.team?.abbreviation,\n    homeTeam: homeTeam?.team?.abbreviation,\n    awayRecord: awayTeam?.records?.[0]?.summary,\n    homeRecord: homeTeam?.records?.[0]?.summary,\n    spread: comp?.odds?.[0]?.details || 'N/A',\n    overUnder: comp?.odds?.[0]?.overUnder || 'N/A',\n    status: event.status?.type?.description\n  };\n}) || [];\n\n// Create compact summary for AI\nconst summary = {\n  week: week,\n  totalGames: games.length,\n  games: games\n};\n\nreturn [{ json: summary }];"
      },
      "id": "63b293b9-cf3d-4326-ad12-90d9a467c4ef",
