    {
      "parameters": {
        "jsCode": "// Get AI response from LangChain node\nconst input = $input.first().json;\n\n// The LangChain chain node returns the response in 'output' field\nlet aiResponse;\n\nif (input.output) {\n  // LangChain format\n  aiResponse = input.output;\n} else if (input.text) {\n  // Alternative format\n  aiResponse = input.text;\n} else if (input.message?.content) {\n  // OpenAI direct format\n  aiResponse = input.message.content;\n} else {\n  // Fallback - try to use the entire input as string\n  aiResponse = JSON.stringify(input);\n}\n\n// Clean the response - remove markdown code blocks if present\naiResponse = aiResponse.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\n// Parse JSON\ntry {\n  const predictions = JSON.parse(aiResponse);\n  return [{ json: predictions }];\n} catch (error) {\n  // If parsing fails, return error with the raw response for debugging\n  throw new Error(`Failed to parse JSON. Raw response: ${aiResponse.substring(0, 500)}... Error: ${error.message}`);\n}"
      },
      "id": "a7cee628-d4c1-4a5a-9cf8-593c04de0a96",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.code",
      "position": [
        -256,
        -288
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// Extract key data\nconst infographicUrl = data.infographic_url || '';\nconst games = data.game_predictions || [];\nconst totalGames = games.length;\nconst topPick = data.top_pick_of_week || {};\n\n// Build game table\nconst gamesTable = games.map((game, i) => `\n  <tr style=\"${i % 2 === 0 ? 'background-color:#1c1c1c;' : 'background-color:#121212;'}\">\n    <td style=\"padding:8px 10px; border-bottom:1px solid #333; font-family:Arial,sans-serif; font-size:14px; color:#fff;\">${game.matchup}</td>\n    <td style=\"padding:8px 10px; border-bottom:1px solid #333; font-weight:bold; color:#ffcc00; font-family:Arial,sans-serif; font-size:14px;\">${game.pick}</td>\n    <td style=\"padding:8px 10px; border-bottom:1px solid #333; font-family:Arial,sans-serif; font-size:14px; color:#ccc;\">${game.spread_pick || 'N/A'}</td>\n    <td style=\"padding:8px 10px; border-bottom:1px solid #333; font-family:Arial,sans-serif; font-size:14px; color:#ccc;\">${game.confidence || '\u2014'}%</td>\n  </tr>\n`).join('');\n\n// Build full email HTML\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\" />\n</head>\n<body style=\"margin:0; padding:0; background-color:#0b0b0b; font-family:Arial,sans-serif;\">\n  <center>\n    <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"\n           style=\"width:600px; max-width:600px; margin:0 auto; background-color:#1a1a1a; border-collapse:collapse; border-radius:10px; overflow:hidden;\">\n\n      <!-- HEADER -->\n      <tr>\n        <td style=\"padding:25px 20px; text-align:center; background:linear-gradient(90deg, #002244, #c60c30);\">\n          <h1 style=\"color:#ffffff; margin:0; font-size:26px; letter-spacing:1px;\">\ud83c\udfc8 NFL Week ${data.week} AI Predictions</h1>\n          <p style=\"color:#dddddd; margin:5px 0 0 0; font-size:14px;\">AI-Powered Game Insights</p>\n        </td>\n      </tr>\n\n      <!-- INFOGRAPHIC IMAGE -->\n      ${infographicUrl ? `\n      <tr>\n        <td style=\"padding:0; background-color:#000;\">\n          <img src=\"${infographicUrl}\" alt=\"NFL Week ${data.week} Infographic\"\n               style=\"display:block; width:100%; max-width:600px; height:auto; border:none;\" />\n        </td>\n      </tr>` : ''}\n\n      <!-- TOP PICK SECTION -->\n      <tr>\n        <td style=\"padding:25px 20px; background-color:#202020; text-align:center; border-top:3px solid #ffcc00;\">\n          <h2 style=\"color:#ffcc00; margin:0 0 10px 0;\">\ud83c\udfc6 Top Pick of the Week</h2>\n          <p style=\"font-size:16px; margin:5px 0; font-weight:bold; color:#ffffff;\">\n            ${topPick.matchup || 'N/A'}\n          </p>\n          <p style=\"font-size:15px; color:#ffcc00; margin:5px 0;\">\n            ${topPick.team || 'TBD'}\n          </p>\n          <p style=\"font-size:13px; color:#cccccc; margin:10px 0 0 0;\">\n            ${topPick.reason || `${topPick.team || ''} are showing strong performance metrics this week.`}\n          </p>\n        </td>\n      </tr>\n\n      <!-- FULL GAME PREDICTIONS -->\n      <tr>\n        <td style=\"padding:20px; background-color:#1a1a1a;\">\n          <h2 style=\"color:#ffcc00; margin:0 0 10px 0;\">\ud83d\udcc8 All Game Predictions (${totalGames} Games)</h2>\n          <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\"\n                 style=\"width:100%; border-collapse:collapse; border:1px solid #333;\">\n            <thead>\n              <tr style=\"background-color:#002244; color:#ffffff;\">\n                <th style=\"padding:10px; text-align:left; font-size:14px;\">Matchup</th>\n                <th style=\"padding:10px; text-align:left; font-size:14px;\">Pick</th>\n                <th style=\"padding:10px; text-align:left; font-size:14px;\">Spread</th>\n                <th style=\"padding:10px; text-align:left; font-size:14px;\">Confidence</th>\n              </tr>\n            </thead>\n            <tbody>\n              ${gamesTable}\n            </tbody>\n          </table>\n        </td>\n      </tr>\n\n      <!-- FOOTER -->\n      <tr>\n        <td style=\"padding:15px; text-align:center; background-color:#111; border-top:1px solid #333;\">\n          <p style=\"margin:0; font-size:12px; color:#888;\">\n            <em>AI-powered predictions for entertainment only. Not financial advice.</em>\n          </p>\n        </td>\n      </tr>\n\n    </table>\n  </center>\n</body>\n</html>\n`;\n\n// Return email data for next node (email sender)\nreturn [{\n  json: {\n    ...data,\n    html_newsletter: html,\n    email_subject: `\ud83c\udfc8 NFL Week ${data.week} AI Predictions \u2013 ${totalGames} Games Analyzed`\n  }\n}];\n"
      },
