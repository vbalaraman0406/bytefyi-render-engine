    {
      "parameters": {
        "jsCode": "const cfg = $('Select Topic & Config').first().json;\nconst rawContent = ($input.first().json.message?.content || '{}')\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/```\\s*$/, '')\n  .trim();\n\nlet parsed = {};\ntry {\n  parsed = JSON.parse(rawContent);\n} catch (e) {\n  parsed = {};\n}\n\nconst defaultCostcoLines = [\n  \"Most Costco members do not realize there is an official thirty-day price adjustment policy.\",\n  \"Last week, I checked my own Costco run after getting an alert and received a forty-three dollar and fifty-six cent refund back on my Visa.\",\n  \"The next day, a second item went on sale for another sixteen dollars and thirty-four cents back \u2014 almost sixty dollars total without returning anything.\",\n  \"The only reason people miss these policies is simple: paper receipts get buried, thermal ink fades, and nobody remembers to re-check prices.\",\n  \"That is why I built a small, private app called Keeps. You just snap a photo of your receipt \u2014 no bank login or card linking required.\",\n  \"It tracks your return windows, warranties, and optional price-drop alerts in one place. It is free to try on Google Play if you find it useful.\"\n];\n\nlet sceneLines = Array.isArray(parsed.sceneLines) && parsed.sceneLines.length === 6\n  ? parsed.sceneLines.map(s => String(s || '').trim())\n  : defaultCostcoLines;\n\nconst fullVoiceoverText = sceneLines.join(' ');\nconst title = String(parsed.title || 'Costco 30-Day Price Adjustment Policy Explained').slice(0, 62).trim();\nconst instagramCaption = String(parsed.instagramCaption || `Most Costco members don't realize there's an official 30-day price adjustment policy \u2014 if an item goes on sale within 30 days, you can show your receipt at the membership desk for the difference without returning the item.\\n\\nI built Keeps to keep track of paper receipts, return deadlines, warranties, and optional price-drop reminders locally on your phone (no bank login required).\\n\\nFree to try on Google Play: ${cfg.playStoreUrl}\\n\\n#costco #consumertips #personalfinance #receipttracker #keepsapp`).trim();\n\nreturn [{\n  json: {\n    ...cfg,\n    title,\n    sceneLines,\n    fullVoiceoverText,\n    instagramCaption\n  }\n}];"
      },
