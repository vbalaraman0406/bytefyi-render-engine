        "jsCode": "const item = $input.first();\nconst scriptData = $('Extract Script Array').first().json;\nconst rawTitle = scriptData.title || 'Costco 30-Day Price Adjustment Policy Explained';\n\nconst safe = rawTitle\n  .replace(/[:]/g, ' ')\n  .replace(/\\r?\\n|\\r/g, ' ')\n  .replace(/[^\\p{L}\\p{N}\\p{P}\\p{Z}]/gu, '')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .substring(0, 65);\n\nconst finalTitle = `${safe} #ConsumerTips #KeepsApp #Shorts`;\nconst description = scriptData.instagramCaption || safe;\n\nreturn [{\n  json: { title: finalTitle, description },\n  binary: item.binary\n}];"
