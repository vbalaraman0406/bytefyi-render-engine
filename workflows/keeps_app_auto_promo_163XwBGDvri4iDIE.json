    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst audioContent = inputData.audio_base64 || inputData.audioContent;\n\nif (!audioContent) {\n  throw new Error('No audio_base64 returned from ElevenLabs Human Voice (TTS)');\n}\n\nconst binaryData = Buffer.from(audioContent, 'base64');\n// ElevenLabs mp3_44100_128 is 128kbps = 16,000 bytes per second\nconst exactAudioSeconds = binaryData.length / 16000;\nconst totalAudioDuration = Number(Math.max(26, exactAudioSeconds + 0.9).toFixed(2));\n\nconst scriptData = $('Extract Script Array').first().json;\nconst sceneLines = Array.isArray(scriptData.sceneLines) && scriptData.sceneLines.length === 6\n  ? scriptData.sceneLines\n  : ['Scene 1', 'Scene 2', 'Scene 3', 'Scene 4', 'Scene 5', 'Scene 6'];\n\nfunction speechWeight(text) {\n  const s = String(text || '').trim();\n  if (!s) return 10;\n  const syllables = (s.toLowerCase().match(/[aeiouy]{1,2}/g) || []).length;\n  const pauses = (s.match(/[,.;:!?\u2014-]/g) || []).length * 2.4;\n  return Math.max(8, syllables + pauses);\n}\n\nconst weights = sceneLines.map(speechWeight);\nconst totalWeight = weights.reduce((a, b) => a + b, 0) || 60;\n\nconst videoDurations = weights.map(w => Number(Math.max(4.0, (w / totalWeight) * totalAudioDuration).toFixed(2)));\nconst sumFirst5 = videoDurations.slice(0, 5).reduce((a, b) => a + b, 0);\nvideoDurations[5] = Number(Math.max(4.2, totalAudioDuration - sumFirst5).toFixed(2));\nconst finalDuration = Number(videoDurations.reduce((a, b) => a + b, 0).toFixed(2));\n\nreturn [{\n  json: {\n    ...scriptData,\n    audioContent,\n    fileName: `keeps_editorial_${Date.now()}.mp3`,\n    audioSize: binaryData.length,\n    totalAudioDuration: finalDuration,\n    videoDurations,\n    totalVideos: 6\n  }\n}];"
      },
