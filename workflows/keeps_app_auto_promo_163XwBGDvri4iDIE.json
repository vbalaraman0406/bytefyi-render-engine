      "parameters": {
        "jsCode": "const d = $('Extract Script Array').first().json;\nconst durInfo = $('Check Audio Length').first().json;\nconst audioUrl = $('GCS - Upload Audio').first().json.mediaLink;\n\nreturn [{\n  json: {\n    mode: 'keeps_editorial',\n    styleKey: d.styleKey,\n    kicker: d.kicker,\n    headline: d.headline,\n    subhead: d.subhead,\n    founderHeadline: d.founderHeadline,\n    includeRealCostcoReceipts: Boolean(d.includeRealCostcoReceipts),\n    storeAvailability: d.storeAvailability,\n    sceneLines: d.sceneLines,\n    videoDurations: durInfo.videoDurations,\n    totalAudioDuration: durInfo.totalAudioDuration,\n    audio_url: audioUrl\n  }\n}];"
      },
