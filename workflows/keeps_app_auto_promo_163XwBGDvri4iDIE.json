      "parameters": {
        "jsCode": "const audioContent = $json.audioContent || $json.audio_base64;\nconst binaryData = Buffer.from(audioContent, 'base64');\nconst fileName = $json.fileName || `keeps_editorial_${Date.now()}.mp3`;\n\nreturn [{\n  json: {\n    ...$json,\n    fileName,\n    audioContent: undefined,\n    audio_base64: undefined\n  },\n  binary: {\n    data: {\n      data: binaryData.toString('base64'),\n      mimeType: 'audio/mpeg',\n      fileName\n    }\n  }\n}];"
