    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst styleKeys = [\n  'COSTCO_POLICY_PROOF',\n  'STORE_RETURN_GUIDE',\n  'THERMAL_RECEIPT_WARRANTY',\n  'PRIVACY_FIRST_TRACKER'\n];\n\nlet nextIdx = ((typeof store.keepsEditorialIndex === 'number' ? store.keepsEditorialIndex : -1) + 1) % styleKeys.length;\nif (!store.keepsEditorialApprovedInit) {\n  nextIdx = 0;\n  store.keepsEditorialApprovedInit = true;\n}\nstore.keepsEditorialIndex = nextIdx;\nconst styleKey = styleKeys[nextIdx] || 'COSTCO_POLICY_PROOF';\n\nconst styles = {\n  COSTCO_POLICY_PROOF: {\n    pillar: 'Consumer Policy Guide: Costco 30-Day Price Adjustment',\n    kicker: 'CONSUMER POLICY GUIDE  \u2022  COSTCO',\n    headline: 'Costco has a 30-day price adjustment policy. Most members never use it.',\n    subhead: 'If an item drops in price within 30 days of purchase, you can request the difference at the membership desk \u2014 without returning the item.',\n    founderHeadline: 'That is why I built Keeps \u2014 a quiet, private receipt tracker.',\n    includeRealCostcoReceipts: true,\n    voiceId: 'IZXMkokQbZW2tD1sqOTx',\n    topic: 'Explain Costco official 30-day price adjustment policy calmly, share my real Nov 10 ($43.56) and Nov 11 ($16.34) Visa refund slips ($59.90 total without returning anything), and mention Keeps quietly at the end as a private local-first receipt tracker with no bank login required.'\n  },\n  STORE_RETURN_GUIDE: {\n    pillar: 'Consumer Policy Guide: Retailer Return & Price-Match Windows',\n    kicker: 'CONSUMER POLICY GUIDE  \u2022  RETURN WINDOWS',\n    headline: 'Major retailers publish clear return & price-match windows. Most people simply forget the dates.',\n    subhead: 'Costco (30 days), Best Buy (15 days), and Target (14 days) all have official adjustment rules \u2014 if you still have the receipt in time.',\n    founderHeadline: 'Why I built a simple receipt tracker with zero bank linking.',\n    includeRealCostcoReceipts: false,\n    voiceId: 'IZXMkokQbZW2tD1sqOTx',\n    topic: 'Walk calmly through verified return and price-adjustment windows at Costco (30 days), Best Buy (15 days), and Target (14 days), why busy shoppers miss them, and quietly mention Keeps at the end as a privacy-first local receipt tracker.'\n  },\n  THERMAL_RECEIPT_WARRANTY: {\n    pillar: 'Consumer Education: Why Thermal Paper Receipts Fade',\n    kicker: 'CONSUMER TIP  \u2022  PRODUCT WARRANTIES',\n    headline: 'Thermal store receipts fade completely in 6 to 12 months \u2014 right when you need a warranty.',\n    subhead: 'Heat-sensitive ink degrades inside wallets and gloveboxes, leaving you without proof of purchase for a 1-year manufacturer claim.',\n    founderHeadline: 'How I keep every receipt legible without handing over bank logins.',\n    includeRealCostcoReceipts: false,\n    voiceId: 'IZXMkokQbZW2tD1sqOTx',\n    topic: 'Explain why thermal paper receipts fade before 1-year electronics or appliance warranties expire, how snapping a 2-second photo protects proof of purchase, and quietly mention Keeps as a local-first receipt vault.'\n  },\n  PRIVACY_FIRST_TRACKER: {\n    pillar: 'Founder Note: Tracking Receipts Without Sharing Bank Passwords',\n    kicker: 'FOUNDER NOTE  \u2022  PRIVACY FIRST',\n    headline: 'You should not have to link your bank account just to organize receipts and return dates.',\n    subhead: 'Most budgeting apps ask for bank credentials. Keeps works locally on your device from a simple photo of your receipt.',\n    founderHeadline: 'Built for privacy-first receipt, return, and warranty tracking.',\n    includeRealCostcoReceipts: false,\n    voiceId: 'IZXMkokQbZW2tD1sqOTx',\n    topic: 'Honest founder note explaining why I built Keeps with local-first storage and zero bank login required so shoppers can track paper receipts, return deadlines, warranties, and optional price-drop alerts privately.'\n  }\n};\n\nconst cfg = styles[styleKey] || styles.COSTCO_POLICY_PROOF;\n\nreturn [{\n  json: {\n    styleKey,\n    ...cfg,\n    autoPublish: true,\n    playStoreUrl: 'https://play.google.com/store/apps/details?id=com.anantaventures.keeps',\n    storeAvailability: 'Search \"Keeps Receipt Scanner\" on Google Play'\n  }\n}];"
      },
